# ==============================================================================
# ZORO — Master .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env*
*.env
*.env.*
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets/
credentials.json
google-credentials.json
id_rsa
id_rsa.pub

# ------------------------------------------------------------------------------
# 2. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 3. IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.zed/

# ------------------------------------------------------------------------------
# 4. Node.js, Frontend & Build Artifacts (apps/web)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.output/

# Cache directories
.eslintcache
.stylelintcache
.turbo/
.parcel-cache/
.vite/
.cache/

# PWA / Service Worker generated files
dev-dist/
sw.js
workbox-*.js

# ------------------------------------------------------------------------------
# 5. Python, FastAPI & Backend Artifacts (apps/api)
# ------------------------------------------------------------------------------
# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging & Distribution
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Type Checking & Linters
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 6. Testing, Quality & Code Coverage
# ------------------------------------------------------------------------------
# Pytest & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
coverage.xml
*.cover
nosetests.xml
coverage.json

# Vitest & Jest
.nyc_output/

# Playwright E2E
test-results/
playwright-report/
playwright/.cache/

# ------------------------------------------------------------------------------
# 7. Local Databases, SQLite & Backups
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.sql.gz
*.dump
dump.rdb
backups/

# ------------------------------------------------------------------------------
# 8. Logs & Scratch / Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
*.log.*
tmp/
temp/
scratch/
.system_generated/

# ------------------------------------------------------------------------------
# 9. Private Documentation & Architecture Specifications
# ------------------------------------------------------------------------------
docs/

